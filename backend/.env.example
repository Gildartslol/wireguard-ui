# Flask Configuration
FLASK_ENV=production
FLASK_APP=app.py
SECRET_KEY=change-this-to-a-secure-random-key-using-secrets.token_urlsafe(32)

# Database Configuration
# DATABASE_URI is auto-determined based on WG_MOCK_MODE
# Only set DATABASE_URI if you need a custom database location in production mode
# DATABASE_URI=sqlite:///wg_dashboard.db

# Mock Mode Configuration (for testing without WireGuard)
# Set WG_MOCK_MODE=true to use mock database with test data
# WG_MOCK_MODE=true
# WG_MOCK_SCENARIO=mixed  # Options: empty, connected, mixed, disconnected

# WireGuard Configuration
WG_INTERFACE=wg0
WG_CONFIG_PATH=/etc/wireguard/wg0.conf
WG_SERVER_ADDRESS=10.0.0.1/24
WG_SERVER_PORT=51820
WG_SERVER_PUBLIC_KEY=

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Monitoring
POLLING_INTERVAL=300
